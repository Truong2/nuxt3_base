# Copy to .env for local development. Never enable demo on a public deployment.
NUXT_DEMO_MODE=true
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
NUXT_SESSION_PASSWORD=replace-this-with-a-random-secret-at-least-32-characters
NUXT_API_BASE_URL=https://backend.example.com
NUXT_APP_ORIGIN=http://localhost:3000
